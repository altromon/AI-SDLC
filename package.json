{
  "name": "ai-sdlc-monorepo",
  "version": "1.0.0",
  "description": "Deterministic, spec-driven development and governance framework for AI-assisted engineering",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"@ai-sdlc/*\" build",
    "test": "vitest run packages",
    "test:example": "vitest run examples",
    "test:all": "vitest run",
    "typecheck": "pnpm --filter \"@ai-sdlc/*\" typecheck",
    "extract:gherkin": "tsx packages/cli/src/index.ts gherkin extract",
    "extract:gherkin:all": "tsx packages/cli/src/index.ts gherkin extract --all",
    "git:validate": "tsx packages/cli/src/index.ts git validate",
    "git:plan": "tsx packages/cli/src/index.ts git plan",
    "git:checkout": "tsx packages/cli/src/index.ts git checkout",
    "verify:governance": "tsx packages/cli/src/index.ts verify governance",
    "verify:testing": "tsx packages/cli/src/index.ts verify testing",
    "verify:quality": "tsx packages/cli/src/index.ts verify quality",
    "verify:traceability": "tsx packages/cli/src/index.ts verify traceability",
    "verify:licenses": "tsx packages/cli/src/index.ts verify licenses",
    "verify:pdac": "tsx packages/cli/src/index.ts verify pdac",
    "verify:schemas": "tsx packages/cli/src/index.ts verify schemas",
    "verify:duplicates": "tsx packages/cli/src/index.ts verify duplicates",
    "verify:security": "tsx packages/cli/src/index.ts verify security",
    "verify:secrets": "tsx packages/cli/src/index.ts verify secrets",
    "verify:sast": "tsx packages/cli/src/index.ts verify sast",
    "verify:all": "tsx packages/cli/src/index.ts verify all",
    "check": "tsx packages/cli/src/index.ts check",
    "check:fix": "tsx packages/cli/src/index.ts check --fix",
    "report:quality": "tsx packages/cli/src/index.ts report quality",
    "report:requirements": "tsx scripts/export-active-requirements.ts",
    "report:docs": "tsx scripts/bundle-documentation.ts",
    "change:new": "tsx packages/cli/src/index.ts change new",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
