{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/safety/hazard.schema.json",
  "title": "Hazard Schema (Operational Hazard & Safety Risk Analysis)",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "severity",
    "probability",
    "fault-tolerance-time-ms",
    "mitigated-by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HAZ-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "hazard"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Versión semántica del peligro (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "retired"]
    },
    "severity": {
      "type": "string",
      "enum": ["catastrophic", "critical", "major", "minor", "negligible"],
      "description": "Severidad del peligro según clasificación funcional de safety (DO-178C / ISO 26262)."
    },
    "probability": {
      "type": "string",
      "enum": ["frequent", "probable", "occasional", "remote", "improbable", "extremely-improbable"],
      "description": "Probabilidad de ocurrencia del peligro operacional."
    },
    "fault-tolerance-time-ms": {
      "type": "number",
      "minimum": 0,
      "description": "Tiempo límite de tolerancia a fallos (FTTI) en milisegundos antes de entrar en estado seguro."
    },
    "mitigated-by": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^SAF-REQ-[A-Z0-9]+(-[A-Z0-9]+)*$"
      },
      "description": "Requisitos de safety que mitigan este peligro."
    },
    "hazardous-condition": {
      "type": "string",
      "description": "Descripción de la condición operacional peligrosa."
    },
    "potential-effect": {
      "type": "string",
      "description": "Efecto potencial sobre personas, aeronave o entorno si el peligro se materializa."
    },
    "supersedes": {
      "type": ["string", "null"]
    },
    "superseded-by": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
