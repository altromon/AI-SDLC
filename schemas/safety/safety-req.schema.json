{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/safety/safety-req.schema.json",
  "title": "Safety Requirement Schema (Functional Safety & Hazard Mitigation)",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "safety-domain",
    "safety-integrity-level",
    "mitigates-hazard",
    "fail-safe-action"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SAF-REQ-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "safety-requirement"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Versión semántica del requisito de safety (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "retired"]
    },
    "safety-domain": {
      "type": "string",
      "enum": [
        "flight-control",
        "collision-avoidance",
        "energy-management",
        "emergency-recovery",
        "sensor-integrity",
        "propulsion",
        "telemetry"
      ],
      "description": "Dominio de seguridad operacional."
    },
    "safety-integrity-level": {
      "type": "string",
      "description": "Nivel de integridad de seguridad (ej. DAL-A..D, ASIL-A..D, SIL-1..4)."
    },
    "mitigates-hazard": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^HAZ-[A-Z0-9]+(-[A-Z0-9]+)*$"
      },
      "description": "Peligros operacionales mitigados por el control de safety."
    },
    "fail-safe-action": {
      "type": "string",
      "description": "Acción automática o maniobra de contingencia para entrar en estado seguro."
    },
    "fault-tolerance-time-ms": {
      "type": "number",
      "description": "Tiempo límite de tolerancia a fallos en milisegundos (FTTI)."
    },
    "acceptance-format": {
      "type": "string",
      "enum": ["gherkin", "declarative-prose"]
    },
    "cucumber-tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": ["string", "null"]
    },
    "superseded-by": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
