{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/privacy/data-asset.schema.json",
  "title": "Personal Data Asset & PII Inventory Schema (DATA-ASSET-*)",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "classification",
    "pii-categories",
    "data-subjects",
    "retention-period",
    "erasure-method"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DATA-ASSET-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "data-asset"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Data asset semantic version (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "retired"]
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential-pii",
        "special-category-sensitive"
      ],
      "description": "Data sensitivity classification aligned with privacy-policy.yaml."
    },
    "pii-categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "identifiers",
          "contact",
          "authentication",
          "financial",
          "location",
          "behavioral",
          "biometric",
          "health",
          "telemetry-operator"
        ]
      }
    },
    "data-subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ACT-[A-Z0-9]+(-[A-Z0-9]+)*$"
      },
      "description": "Product actors (ACT-*) whose personal data is stored or processed."
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sensitivity", "masking-strategy"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sensitivity": {
            "type": "string",
            "enum": ["public", "internal", "pii", "special-category"]
          },
          "masking-strategy": {
            "type": "string",
            "enum": [
              "none",
              "redact",
              "sha256-salt",
              "tokenize",
              "aes-256-gcm",
              "truncate"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "retention-period": {
      "type": "string",
      "pattern": "^([0-9]+(d|m|y)|session-only|indefinite-anonymized)$",
      "description": "Maximum retention TTL (e.g. 30d, 12m, 5y, session-only, indefinite-anonymized)."
    },
    "erasure-method": {
      "type": "string",
      "enum": [
        "hard-delete",
        "crypto-shredding",
        "irreversible-anonymization"
      ]
    },
    "owner-bounded-context": {
      "type": "string",
      "pattern": "^(BC|CMP)-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^DATA-ASSET-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "superseded-by": {
      "type": ["string", "null"],
      "pattern": "^DATA-ASSET-[A-Z0-9]+(-[A-Z0-9]+)*$"
    }
  },
  "additionalProperties": false
}
