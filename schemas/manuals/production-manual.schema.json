{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/manuals/production-manual.schema.json",
  "title": "AI-SDLC Production & Operations Manual Schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "applies-to-version",
    "target-audience"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MAN-PROD-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Identificador inmutable del manual de producción (ej. MAN-PROD-SENTINELCORE)."
    },
    "type": {
      "type": "string",
      "const": "production-manual"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Versión semántica del documento (SemVer)."
    },
    "schema-version": {
      "type": "string",
      "description": "Versión del esquema de la plantilla."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "description": "Título descriptivo del manual de producción."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "retired"]
    },
    "applies-to-version": {
      "type": "string",
      "description": "Versión o release del software al que aplica este manual de producción (ej. v1.0.0)."
    },
    "target-audience": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Perfiles técnicos a los que va dirigido (ej. DevOps, SRE, Release Manager, SecOps)."
    },
    "components-covered": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$"
      },
      "description": "Componentes de arquitectura (CMP-*) desplegados y cubiertos por el manual."
    },
    "enclaves-involved": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SEC-ENC-[A-Z0-9]+(-[A-Z0-9]+)*$"
      },
      "description": "Enclaves de seguridad (SEC-ENC-*) en los que se ejecuta el despliegue."
    },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^MAN-PROD-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "superseded-by": {
      "type": ["string", "null"],
      "pattern": "^MAN-PROD-[A-Z0-9]+(-[A-Z0-9]+)*$"
    }
  },
  "additionalProperties": false
}
