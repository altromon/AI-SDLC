{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/architecture/service.schema.json",
  "title": "NAF v4 / arc42 Service Schema (Versionable)",
  "type": "object",
  "required": ["id", "type", "title", "status", "version", "implements-use-cases", "hosted-in-enclave"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SRV-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "service"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Versión del contrato del servicio de arquitectura (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "deprecated", "retired"]
    },
    "implements-use-cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^UC-[A-Z0-9]+(-[A-Z0-9]+)*$"
      }
    },
    "satisfies-requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(FR|QR|CON|SEC-REQ)-[A-Z0-9]+(-[A-Z0-9]+)*$"
      }
    },
    "hosted-in-enclave": {
      "type": "string",
      "pattern": "^SEC-ENC-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "protocol"],
        "properties": {
          "name": { "type": "string" },
          "protocol": { "type": "string", "enum": ["REST/HTTP", "gRPC", "WebSocket", "Kafka", "MQTT"] },
          "contract-spec": { "type": "string" }
        }
      }
    },
    "supersedes": {
      "type": "string",
      "pattern": "^SRV-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "superseded-by": {
      "type": "string",
      "pattern": "^SRV-[A-Z0-9]+(-[A-Z0-9]+)*$"
    }
  },
  "additionalProperties": false
}
