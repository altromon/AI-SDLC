{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/sdd/design.schema.json",
  "title": "Spec-Driven Development Technical Design Schema (DSG-*)",
  "type": "object",
  "required": ["id", "type", "title"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(DSG-[A-Z0-9]+(-[A-Z0-9]+)*|CHG-[A-Z0-9]+-DESIGN|[A-Z0-9]+(-[A-Z0-9]+)*)$",
      "description": "Unique identifier of the technical design specification."
    },
    "type": {
      "type": "string",
      "enum": ["spec-design", "spec-change-design", "design"]
    },
    "change-id": {
      "type": "string",
      "pattern": "^(CHG|FEAT|PATCH)-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Parent change identifier associated with this design."
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Semantic versioning (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "handoff": {
      "type": "string",
      "pattern": "^HOF-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Reference to the HOF-* sidecar."
    },
    "architecture-component": {
      "type": "string",
      "pattern": "^CMP-[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Associated architecture component."
    },
    "enclave": {
      "type": "string",
      "pattern": "^(SEC-ENC-)?[A-Z0-9]+(-[A-Z0-9]+)*$",
      "description": "Zero trust security enclave."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "review",
        "approved",
        "active",
        "completed",
        "deprecated"
      ]
    },
    "author": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "digest": { "type": "string" },
          "comment": { "type": "string" },
          "anchor": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
