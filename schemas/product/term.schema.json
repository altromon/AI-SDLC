{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.org/schemas/product/term.schema.json",
  "title": "Domain Glossary Term Schema (Ubiquitous Language)",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "status",
    "version",
    "definition",
    "bounded-context"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TERM-[A-Z0-9]+(-[A-Z0-9]+)*$"
    },
    "type": {
      "type": "string",
      "const": "term"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "Versión semántica del término (SemVer)."
    },
    "schema-version": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "description": "Nombre canónico del término en el lenguaje ubicuo del dominio."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "retired"]
    },
    "definition": {
      "type": "string",
      "minLength": 10,
      "description": "Definición precisa y no ambigua del término en el contexto del dominio."
    },
    "bounded-context": {
      "type": "string",
      "description": "Bounded context de DDD al que pertenece este término (ej. FlightControl, Telemetry, Billing)."
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sinónimos o términos alternativos usados coloquialmente que se mapean a este término canónico."
    },
    "anti-terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Términos incorrectos o ambiguos que NO deben usarse para referirse a este concepto."
    },
    "related-terms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TERM-[A-Z0-9]+(-[A-Z0-9]+)*$"
      },
      "description": "Términos del glosario relacionados semánticamente."
    },
    "supersedes": {
      "type": ["string", "null"]
    },
    "superseded-by": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
