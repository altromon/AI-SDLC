                "cwe": [
                  "CWE-918"
                ],
                "owasp": [
                  "A10:2021-Server-Side Request Forgery (SSRF)"
                ]
              }
            },
            {
              "id": "SAST-005-PATH-TRAVERSAL",
              "name": "PATH_TRAVERSAL",
              "shortDescription": {
                "text": "Lectura o escritura en sistema de archivos construida directamente desde parámetros no saneados"
              },
              "fullDescription": {
