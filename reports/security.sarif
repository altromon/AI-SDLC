{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "aisdlc-security",
          "version": "2.2.0",
          "informationUri": "https://github.com/altromon/AI-SDLC",
          "rules": [
            {
              "id": "SAST-001-SQL-INJECTION",
              "name": "SQL_INJECTION",
              "shortDescription": {
                "text": "Concatenación o interpolación directa de variables en consulta SQL dinámica"
              },
              "fullDescription": {
                "text": "Concatenación o interpolación directa de variables en consulta SQL dinámica"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "sast"
                ],
                "cwe": [
                  "CWE-89"
                ],
                "owasp": [
                  "A03:2021-Injection"
                ]
              }
            },
            {
              "id": "SAST-002-COMMAND-INJECTION",
              "name": "COMMAND_INJECTION",
              "shortDescription": {
                "text": "Ejecución dinámica de comandos del sistema operativo con argumentos variables"
              },
              "fullDescription": {
                "text": "Ejecución dinámica de comandos del sistema operativo con argumentos variables"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "sast"
                ],
                "cwe": [
                  "CWE-78"
                ],
                "owasp": [
                  "A03:2021-Injection"
                ]
              }
            },
            {
              "id": "SAST-003-UNSAFE-EVAL",
              "name": "UNSAFE_EVAL",
              "shortDescription": {
                "text": "Uso de evaluación dinámica de código (eval o Function constructor)"
              },
              "fullDescription": {
                "text": "Uso de evaluación dinámica de código (eval o Function constructor)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "sast"
                ],
                "cwe": [
                  "CWE-95"
                ],
                "owasp": [
                  "A03:2021-Injection"
                ]
              }
            },
            {
              "id": "SAST-004-SSRF-UNVALIDATED-FETCH",
              "name": "SSRF",
              "shortDescription": {
                "text": "Petición de red saliente (fetch/http/axios) con URL dinámica sin validación previa"
              },
              "fullDescription": {
                "text": "Petición de red saliente (fetch/http/axios) con URL dinámica sin validación previa"
              },
